# Copy to .env.local if the ground station is not on the default address.
# Every value below is also the built-in default.

# Where the Vite dev/preview server proxies /api to.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Only needed when the dashboard is served from somewhere that cannot proxy —
# a static host, for example. Leaving these unset keeps the browser on one
# origin, which avoids CORS entirely.
# VITE_API_URL=https://gcs.example.internal
# VITE_WS_URL=wss://gcs.example.internal/ws/telemetry
